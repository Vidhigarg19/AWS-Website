# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email Configuration
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=AWS Student Builders Group <your_email@example.com>
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# Feature Flags
NEXT_PUBLIC_RECRUITMENT_STATUS=open

# AWS S3 media storage (Media Portal). Values come from the CloudFormation outputs,
# see infra/README.md. No access keys: on Amplify the compute IAM role provides
# credentials. (Amplify reserves env names starting with AWS_, so we use S3_*.)
S3_BUCKET=aws-sbg-media-prod
S3_REGION=ap-south-1
MEDIA_CDN_URL=https://dxxxxxxxxxxxxx.cloudfront.net

# Google Drive link import (Media Portal). Create an API key in Google Cloud, enable
# "Google Drive API", and restrict the key to that API only. Server-side only: never prefix NEXT_PUBLIC_.
GOOGLE_DRIVE_API_KEY=your_google_api_key

# Scheduled cleanup (Media Portal, Step 9). Generate with: openssl rand -hex 32
# The cleanup endpoint is OFF unless this is set and at least 32 characters.
CRON_SECRET=
# CloudFormation output "DistributionId". Optional: lets cleanup invalidate purged files on the CDN.
MEDIA_CDN_DISTRIBUTION_ID=
